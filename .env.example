# RunningHub（runninghub.cn）控制台「API 调用」里的 key
RUNNINGHUB_API_KEY=
# 同时跑几段：会员 key 是 5；企业 key 可以开大
RUNNINGHUB_CONCURRENCY=5
# 一个 RH 币折多少钱（用来算成本；Max 包月 ¥399 = 18 万币）
# RUNNINGHUB_COIN_CNY=0.002217

# APIMart（apimart.ai）的 key：画分镜图（GPT Image 2.5），查烧字幕（Gemini），没装 Claude Code 时也用它改写提示词
APIMART_API_KEY=
# 分镜图清晰度和质量：1k / 2k，low / medium / high
# IMAGE_RESOLUTION=1k
# IMAGE_QUALITY=medium

# 提示词改写：auto（装了 Claude Code 就用它）/ claude / llm（任何 OpenAI 兼容接口）
# H3_REWRITER=auto
# CLAUDE_MODEL=opus
# LLM_BASE_URL=https://api.apimart.ai/v1
# LLM_API_KEY=
# LLM_MODEL=deepseek-v4-pro

# MiniMax 官方提示词指南默认从 GitHub 现取；网络不通就下载 ref-en.txt 后指过去
# H3_GUIDE_FILE=/path/to/ref-en.txt
